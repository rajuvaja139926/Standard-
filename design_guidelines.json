{
  "app_name": "HOTELBOOK",
  "app_type": "hybrid_fullstack",
  "theme": {
    "mode": "light",
    "primary_color": "#0F172A",
    "brand_color": "#D97706",
    "accent_color": "#0284C7",
    "background_color": "#F8FAFC",
    "surface_color": "#FFFFFF",
    "text_primary": "#0F172A",
    "text_secondary": "#64748B",
    "border_color": "#E2E8F0"
  },
  "typography": {
    "font_family_heading": "Outfit, sans-serif",
    "font_family_body": "Inter, sans-serif",
    "hierarchy": {
      "h1": "text-4xl sm:text-5xl lg:text-6xl tracking-tight font-extrabold",
      "h2": "text-2xl sm:text-3xl lg:text-4xl tracking-tight font-bold",
      "h3": "text-xl sm:text-2xl font-semibold",
      "h4": "text-lg sm:text-xl font-medium",
      "body": "text-base text-slate-600",
      "small": "text-sm text-slate-500"
    }
  },
  "colors": {
    "primary": "#0F172A",
    "brand": "#D97706",
    "success": "#10B981",
    "warning": "#F59E0B",
    "danger": "#EF4444",
    "neutral_light": "#F8FAFC",
    "neutral_dark": "#0F172A",
    "card_bg": "#FFFFFF",
    "glass_bg": "rgba(255, 255, 255, 0.85)"
  },
  "visual_enhancers": {
    "shadows": [
      "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
      "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
    ],
    "border_radius": "rounded-xl",
    "glassmorphism": "backdrop-blur-xl bg-white/80 border border-white/20 shadow-lg",
    "textures": "Subtle dot matrix and warm radial gradients"
  },
  "grids": {
    "hero_bento": "grid grid-cols-1 md:grid-cols-12 gap-6",
    "dashboard_grid": "grid grid-cols-1 md:grid-cols-4 gap-6",
    "hotel_listings": "grid grid-cols-1 md:grid-cols-3 gap-8"
  },
  "layouts": {
    "container_padding": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8",
    "flex_between": "flex items-center justify-between",
    "sticky_header": "sticky top-0 z-50 backdrop-blur-xl bg-white/90 border-b border-slate-200"
  },
  "motion": {
    "transition_defaults": "transition-all duration-200 ease-in-out",
    "hover_lift": "hover:-translate-y-1 hover:shadow-xl",
    "button_press": "active:scale-95"
  },
  "accessibility": {
    "contrast_ratio_min": "4.5:1 for normal text, 3:1 for large text",
    "focus_states": "focus:ring-2 focus:ring-amber-500 focus:outline-none",
    "aria_labels": "MANDATORY on all icon buttons and interactive elements",
    "test_ids": "MANDATORY `data-testid` on all buttons, links, inputs, cards, and interactive components"
  },
